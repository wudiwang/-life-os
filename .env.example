# 复制此文件为 .env 并填写（Supabase Dashboard → Settings → API）
# 不填也能跑：自动进入"演示模式"，数据存浏览器 localStorage

VITE_SUPABASE_URL=https://你的项目ID.supabase.co
VITE_SUPABASE_ANON_KEY=你的anon_key

# ── 服务端（Vercel 环境变量，api/* 用，本地开发可不填）──
CLAUDE_API_KEY=你的claude_api_key

# ── Telegram 机器人（npm run bot，本机运行）──
TELEGRAM_BOT_TOKEN=BotFather给的token
# 你的 chat id：首次运行机器人并给它发消息时，控制台会打印出来
TG_ALLOWED_CHAT_ID=
